#!/usr/bin/env ruby
# encoding: utf-8

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require 'rouge'
require 'optparse'

options = { rubocop: false, mode: :file }
output = nil

parser = OptionParser.new do |o|
  o.banner = "Usage: rougec [options] [file.clj]"
  o.on("-o", "--output FILE", "Write Ruby to FILE (default: alongside input)") { |f| output = f }
  o.on("--stdout", "Write transpiled Ruby to stdout") { options[:mode] = :stdout }
  o.on("--rubocop", "Run `rubocop -A` over the output when available") { options[:rubocop] = true }
  o.on("-e", "--eval CODE", "Transpile-then-eval CODE and print the result") do |code|
    options[:mode] = :eval
    options[:code] = code
  end
  o.on("--run FILE", "Transpile-then-eval FILE") do |f|
    options[:mode] = :run
    options[:file] = f
  end
  o.on("--repl", "Start an interactive transpile-then-eval REPL") { options[:mode] = :repl }
  o.on("--compile", "Compile the whole project (per rouge.edn) to plain Ruby") { options[:mode] = :compile }
  o.on("--nrepl [PORT]", Integer, "Start a bencode nREPL server (default port 7888)") do |p|
    options[:mode] = :nrepl
    options[:port] = p || 7888
  end
  o.on("-h", "--help", "Show this help") do
    puts o
    exit
  end
end
parser.parse!

case options[:mode]
when :eval
  puts Rouge::Interpreter.new.eval_str(options[:code]).inspect
when :run
  puts Rouge::Interpreter.new.eval_str(File.read(options[:file])).inspect
when :repl
  require 'readline'
  interp = Rouge::Interpreter.new
  show_ruby = false
  puts "Rouge REPL — transpile-then-eval. Type :ruby to toggle showing emitted Ruby, :quit to exit."
  while (line = Readline.readline("rouge=> ", true))
    line = line.strip
    next if line.empty?
    break if %w[:quit :exit].include?(line)

    if line == ":ruby"
      show_ruby = !show_ruby
      puts "(show emitted Ruby: #{show_ruby})"
      next
    end

    begin
      Rouge::Reader.read_all(line).each do |form|
        puts interp.transpile_form(form) if show_ruby
        p interp.eval_form(form)
      end
    rescue StandardError => e
      warn "#{e.class}: #{e.message}"
    end
  end
when :compile
  written = Rouge::Compiler.new(Rouge::Config.load(Dir.pwd)).compile_all
  written.each { |w| warn "Compiled #{w}" }
  warn "Compiled #{written.length} file(s)."
when :nrepl
  require 'rouge/nrepl/server'
  Rouge::Nrepl::Server.new(config: Rouge::Config.load(Dir.pwd), port: options[:port]).start
when :stdout
  source = ARGF.read
  print Rouge::Transpiler.transpile(source, rubocop: options[:rubocop])
else # :file
  input = ARGV.first
  abort parser.to_s if input.nil?

  ruby = Rouge::Transpiler.transpile(File.read(input), rubocop: options[:rubocop])
  output ||= input.sub(/\.(clj|rg|rouge)\z/, "") + ".rb"
  File.write(output, ruby)
  warn "Wrote #{output}"
end

# vim: set sw=2 et cc=80:
